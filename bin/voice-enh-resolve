#!/bin/sh
set -eu
# Resolve/AppleScript starts commands with a minimal PATH; include standard
# Homebrew locations so ffmpeg and related tools are available.
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export PATH
INPUT=""
for ARG in "$@"; do
  if [ -f "$ARG" ]; then INPUT="$ARG"; break; fi
done
LOG=/tmp/voice-enh-resolve.log
if [ -z "$INPUT" ] && command -v pbpaste >/dev/null 2>&1; then
  # Resolve's Clipboard mode launches the command without argv and places
  # the bounced file path on the macOS clipboard instead.
  CLIP=$(pbpaste 2>/dev/null || true)
  CLIP=$(printf '%s\n' "$CLIP" | sed -n '1p' | tr -d '\r')
  if [ -f "$CLIP" ]; then
    INPUT="$CLIP"
    printf '%s\n' "$(date) clipboard input: $INPUT" >> "$LOG"
  fi
fi
printf '%s\n' "$(date) args: $* input: $INPUT" >> "$LOG"
if [ -z "$INPUT" ]; then echo "voice-enh-resolve: no input file in arguments or clipboard" >&2; exit 2; fi
PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
RUNTIME_DIR="${TMPDIR:-/tmp}/voice-enh-runtime"
mkdir -p "$RUNTIME_DIR"
cd "$RUNTIME_DIR"
export PYTHONPATH="$PROJECT_DIR${PYTHONPATH:+:$PYTHONPATH}"
set +e
"$PROJECT_DIR/.venv/bin/python" -m voice_enh --resolve "$INPUT" >> "$LOG" 2>&1
STATUS=$?
printf '%s\n' "$(date) exit: $STATUS" >> "$LOG"
exit "$STATUS"
